# Required — used by /api/explain to generate AI explanations, gap reasoning,
# and the recommended project. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional — used by /api/github. Without this, GitHub's unauthenticated API
# is used (60 requests/hour, shared across all visitors to your deployment).
# With a token (no special scopes needed, just a plain classic or fine-grained
# personal access token), the limit rises to 5,000 requests/hour.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=
