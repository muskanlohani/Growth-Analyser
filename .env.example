# Required — used by /api/explain to generate the AI summary, point-wise
# recommendations, quick wins and the recommended project (Google Gemini).
# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — which Gemini model to use. Defaults to gemini-3.5-flash-lite.
# If the model is unavailable or rate-limited, gemini-3.8-flash and then
# gemini-2.5-flash are tried automatically. See https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional — used by /api/github. Without this, GitHub's unauthenticated API
# is used (60 requests/hour, shared across all visitors to your deployment).
# With a token (no special scopes needed, just a plain classic or fine-grained
# personal access token), the limit rises to 5,000 requests/hour, and recent
# activity is read from more pages of events.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=
